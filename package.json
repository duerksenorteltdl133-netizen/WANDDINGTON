{
  "name": "waddington",
  "version": "0.1.0",
  "description": "Single-cell gene perturbation AI agent for biologists",
  "license": "MIT",
  "type": "module",
  "bin": {
    "waddington": "bin/waddington.js"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "pi": {
    "extensions": ["./extensions"],
    "prompts":    ["./prompts"],
    "skills":     ["./skills"]
  },
  "scripts": {
    "dev":        "tsx src/index.ts",
    "build":      "tsc -p tsconfig.build.json",
    "typecheck":  "tsc --noEmit",
    "start":      "node bin/waddington.js"
  },
  "dependencies": {
    "@clack/prompts":              "^1.2.0",
    "@companion-ai/alpha-hub":     "^0.1.3",
    "@mariozechner/pi-ai":         "^0.72.1",
    "@mariozechner/pi-coding-agent": "^0.72.1",
    "@sinclair/typebox":           "^0.34.49",
    "dotenv":                      "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx":         "^4.21.0",
    "typescript":  "^5.9.3"
  },
  "overrides": {
    "basic-ftp": "5.3.0",
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.14",
      "hono": "4.12.14"
    },
    "express": {
      "router": { "path-to-regexp": "8.4.2" }
    },
    "protobufjs": "7.5.5",
    "minimatch":  { "brace-expansion": "5.0.5" }
  }
}
