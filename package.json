{
  "name": "waddington",
  "version": "0.1.0",
  "description": "Single-cell gene perturbation AI agent for biologists",
  "license": "MIT",
  "type": "module",
  "bin": {
    "waddington": "bin/waddington.js"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node bin/waddington.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@companion-ai/alpha-hub": "^0.1.3",
    "@earendil-works/pi-agent-core": "^0.75.5",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@sinclair/typebox": "^0.34.49",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "undici": "^8.3.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "@types/ws": "8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "basic-ftp": "5.3.0",
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.14",
      "hono": "4.12.14"
    },
    "express": {
      "router": {
        "path-to-regexp": "8.4.2"
      }
    },
    "protobufjs": "7.5.5",
    "minimatch": {
      "brace-expansion": "5.0.5"
    }
  }
}
